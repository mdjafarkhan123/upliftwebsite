# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)

# Astro puts a content hash in every file name here, so a changed file gets a new URL:
# browsers may keep these for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and sprites keep their names when they change: a week, then refreshed in the background.
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/sprite.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/abovethefold.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
