---
import type { HTMLAttributes } from "astro/types";

type Prettify<T> = {
    [K in keyof T]: T[K];
} & {};

type Props = Prettify<
    HTMLAttributes<"svg"> & {
        /** The text label displayed on the button. Default: "Get started" */
        size?: number;
        /** The visual style type of the button (e.g., "primary", "secondary"). Default: "primary" */
        name?: string;
        /** Optional HTML ID for the anchor element. */
        src?: string;
        className?: string;
    }
>;

const {
    size = 24,
    name = "icon",
    src = "sprite",
    className = "svg-icon",
}: Props = Astro.props;
---

<svg
    class={`icon ${className}`}
    style="aspect-ratio: 1 / 1;"
    width={size}
    data-sprite
>
    <use xlink:href={`/${src}.svg#${name}`}></use>
</svg>
