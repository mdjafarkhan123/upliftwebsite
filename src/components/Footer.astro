---
import Brand from "./Brand.astro";
import { footer, publicSite } from "../data/data.js";
---

<footer id="footer" class="container footer">
    <div class="footer__main">
        <div>
            <Brand />
            <p>{footer.intro.title}</p>
        </div>
        <div>
            <p class="badge">{footer.contact.title}</p>
            <a href={`mailto:${publicSite.contact.email}`}>
                {publicSite.contact.email}
            </a>
            <a href={`tel:${publicSite.contact.phone}`}>
                {publicSite.contact.phone}
            </a>
            <span>{publicSite.location}</span>
        </div>
        <div>
            <p class="badge">{footer.company.title}</p>
            {footer.company.items.map((item) => (
                <a href={item.href}>{item.label}</a>
            ))}
        </div>
    </div>
    <div class="footer__bottom">
        <span>
            © {new Date().getFullYear()} {publicSite.name}
        </span>
        <div>
            {footer.resources.items.map((item) => (
                <a href={item.href}>{item.label}</a>
            ))}
        </div>
    </div>
</footer>
