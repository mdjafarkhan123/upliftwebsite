---
import Brand from "./Brand.astro";
import Button from "./Button.astro";
import Icon from "./Svg.astro";
import { footer, hero, navigation, publicSite } from "../data/data.js";
const bookingLink = publicSite.booking.url || publicSite.booking.fallbackUrl;
const items = footer.company.items.filter((item) => item.href !== "/");
---

<header id="header" class="header container">
    <Brand />
    <nav class="header__nav" aria-label="Main navigation">
        {items.map((item) => (
            <a class="header__link" href={item.href}>
                {item.label}
            </a>
        ))}
    </nav>
    <div class="header__actions">
        <Button title={hero.cta} link={bookingLink} type="small" />
        <button
            class="header__menu-toggler"
            type="button"
            aria-label={navigation.openLabel}
            aria-controls="mobile-navigation"
            aria-expanded="false"
            hidden
        >
            {navigation.menuLabel}
        </button>
    </div>
    <dialog
        class="mobile-menu"
        id="mobile-navigation"
        aria-labelledby="mobile-menu-title"
    >
        <div class="mobile-menu__top">
            <Brand />
            <button
                class="mobile-menu__close"
                type="button"
                aria-label={navigation.closeLabel}
                autofocus
            >
                <span aria-hidden="true">
                    <Icon name="plus-icon" />
                </span>
            </button>
        </div>
        <div class="mobile-menu__body">
            <p class="mobile-menu__eyebrow" id="mobile-menu-title">
                {footer.company.title}
            </p>
            <nav class="mobile-menu__nav" aria-label="Mobile navigation">
                {footer.company.items.map((item, i) => (
                    <a class="mobile-menu__link" href={item.href}>
                        <span class="mobile-menu__number" aria-hidden="true">
                            0{i + 1}
                        </span>
                        <span>{item.label}</span>
                        <span class="mobile-menu__arrow" aria-hidden="true">
                            <Icon name="arrow-button" src="abovethefold" />
                        </span>
                    </a>
                ))}
            </nav>
            <div class="mobile-menu__contact">
                <p>{hero.badge}</p>
                <Button title={hero.cta} link={bookingLink} />
                <a href={`mailto:${publicSite.contact.email}`}>
                    {publicSite.contact.email}
                </a>
                <a href={`tel:${publicSite.contact.phone}`}>
                    {publicSite.contact.phone}
                </a>
            </div>
        </div>
    </dialog>
</header>
