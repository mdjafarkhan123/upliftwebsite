---
import Icon from "./Svg.astro";
interface Props {
    question: string;
    answer: string;
    number: number;
    /** Show the "01" style number before the question. */
    showIndex?: boolean;
    /** Sprite symbol for the toggle. */
    icon?: string;
    /** Optional second symbol shown while the item is open, such as a minus. */
    openIcon?: string;
    /** Sprite that holds the icons. */
    iconSrc?: string;
    /** Put the icon's shapes in the page so CSS can animate them (plus → minus). */
    inlineIcon?: boolean;
}
const {
    question,
    answer,
    number,
    showIndex = true,
    icon = "plus-icon",
    openIcon,
    iconSrc = "sprite",
    inlineIcon = false,
} = Astro.props;
---

<div class:list={["faq__item", { "is-open": number === 0 }]} role="listitem">
    <h3 class="faq__item-heading">
        <button
            type="button"
            id={`faq-trigger-${number}`}
            class="faq__trigger"
            aria-expanded={number === 0 ? "true" : "false"}
            aria-controls={`faq-panel-${number}`}
        >
            {showIndex && <span class="faq__index">0{number + 1}</span>}
            <span class="faq__question">
                {question}
            </span>
            <span class="faq__icon" aria-hidden="true">
                {openIcon ? (
                    <>
                        <Icon name={icon} src={iconSrc} className="faq__icon-closed" />
                        <Icon name={openIcon} src={iconSrc} className="faq__icon-open" />
                    </>
                ) : (
                    <Icon name={icon} src={iconSrc} inline={inlineIcon} />
                )}
            </span>
        </button>
    </h3>
    <div
        id={`faq-panel-${number}`}
        class="faq__panel"
        role="region"
        aria-labelledby={`faq-trigger-${number}`}
    >
        <div class="faq__answer">
            <p>{answer}</p>
        </div>
    </div>
</div>
