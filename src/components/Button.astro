---
import Icon from "./Svg.astro";
interface Props {
    title: string;
    link: string;
    type?: "primary" | "small";
    id?: string;
    icon?: string;
    src?: string;
}
const {
    title,
    link,
    type = "primary",
    id,
    icon = "arrow-button",
    src = "abovethefold",
} = Astro.props;
---

<a id={id} href={link} class:list={["btn", { "btn--small": type === "small" }]}>
    <span class="btn__text">{title}</span>
    <span class="btn__icon" aria-hidden="true">
        <Icon name={icon} src={src} />
    </span>
</a>
