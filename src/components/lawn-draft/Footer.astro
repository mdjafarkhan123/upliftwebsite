---
import Brand from "./Brand.astro";
import Icon from "../Svg.astro";
---

<footer class="garden-footer">
  <div class="wrap footer-top">
    <div>
      <Brand />
      <p>
        Good care. Greener spaces.
        <br />
        More life outside.
      </p>
    </div>
    <nav aria-label="Footer navigation">
      <a href="#services">Services</a>
      <a href="#about">Our approach</a>
      <a href="#projects">Garden inspiration</a>
      <a href="#journal">Field notes</a>
    </nav>
    <nav aria-label="Get in touch">
      <a href="#quote">
        Plan your lawn care <Icon name="arrow-right-up" size={18} />
      </a>
      <a href="#locations">Service areas</a>
      <a href="#faq">Your questions</a>
    </nav>
  </div>
  <div class="wrap footer-wordmark" aria-hidden="true">
    let life grow.
  </div>
  <div class="wrap footer-bottom">
    <span>Greenland · Lawn & landscape design concept</span>
    <span>Made for a life outdoors.</span>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>
