---
import { Image } from 'astro:assets';
import Logo from '../components/Logo.astro';
import Jafar from '../assets/images/jafar.jpg';
import ContractorPhoto from '../assets/images/indextwo-contractor.png';
import { publicSite, hero, services, projects, contractors, about, reason, process, faq, cta, footer } from '../data/data.js';
const bookingLink = publicSite.booking.url || publicSite.booking.fallbackUrl;
const nav = footer.company.items.filter(item => ['Services', 'Platform', 'About', 'Process', 'FAQs'].includes(item.label));
const symbols = ['⌘', '☆', '↗', '◎', '⌖', '▦'];
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="description" content={footer.intro.title} />
    <title>{publicSite.name} — {footer.intro.title}</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="preload" href="/fonts/body-regular.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header wrap">
        <a class="brand" href="/indextwo" aria-label={publicSite.name}><Logo width="30" height="36" /><span>{publicSite.name.split(" ")[0]}<span class="brand-small">{publicSite.name.split(" ").slice(1).join(" ")}</span></span></a>
        <nav aria-label="Main navigation">{nav.map(item => <a href={item.href.replace('/#', '#')}>{item.label}</a>)}</nav>
        <a class="button small" href={bookingLink}>{hero.cta}<span aria-hidden="true">↗</span></a>
    </header>
    <main id="main">
        <section id="hero" class="hero wrap">
            <div class="hero-copy">
                <p class="eyebrow"><span class="status-dot"></span>{hero.badge}</p>
                <h1 set:html={hero.title} />
                <div class="hero-description" set:html={hero.description} />
                <div class="hero-actions"><a class="button" href={bookingLink}>{hero.cta}<span aria-hidden="true">↗</span></a><a class="text-link" href="#services">{services.badge}<span aria-hidden="true">↓</span></a></div>
            </div>
            <div class="system" aria-label={footer.intro.title}>
                <div class="system-top"><span>{publicSite.name}</span><span aria-hidden="true">↗</span></div>
                <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
                <div class="system-core"><Logo width="52" height="62" /><span>{publicSite.name}</span></div>
                {services.content.map((service, i) => <a class={`system-node node-${i}`} href={`#service-${i}`}><span class="node-icon" aria-hidden="true">{symbols[i]}</span><span>{service.title}</span></a>)}
                <div class="system-bottom"><span class="status-dot"></span>{footer.intro.title}</div>
            </div>
        </section>
        <section id="why" class="principles wrap" aria-label={reason.badge}>{reason.content.map((item, i) => <div><span aria-hidden="true">0{i + 1} /</span>{item.title}</div>)}</section>
        <section id="services" class="section wrap">
            <div class="section-heading"><p class="eyebrow">01 / {services.badge}</p><h2 set:html={services.title} /></div>
            <div class="service-grid">
                {services.content.map((service, i) => <article id={`service-${i}`} class:list={['service-card', { featured: i === 0 }]}>
                    <div class="service-copy"><div class="card-top"><span class="service-icon" aria-hidden="true">{symbols[i]}</span><span class="index">0{i + 1}</span></div><h3>{service.title}</h3><p set:html={service.description} /><details><summary>{about.readMore}<span aria-hidden="true">+</span></summary><ul>{service.items.map(item => <li set:html={item} />)}</ul></details></div>
                    {i === 0 && <div class="website-preview"><div class="browser-bar"><i></i><i></i><i></i><span>{publicSite.name}</span></div><Image src={service.thumbnail} alt="Contractor website design preview" width={760} loading="lazy" /></div>}
                </article>)}
            </div>
        </section>
        <section id="projects" class="section wrap projects-section" aria-labelledby="projects-heading">
            <div class="section-heading">
                <p class="eyebrow">02 / {projects.badge}</p>
                <h2 id="projects-heading">{projects.title}</h2>
            </div>
            <div class="project-grid">
                {projects.items.map((project, i) => (
                    <figure class="project-card">
                        <div class="project-image">
                            <div class="project-browser" aria-hidden="true"><i></i><i></i><i></i></div>
                            <Image src={project.thumbnail} alt={project.title} width={900} loading="lazy" />
                        </div>
                        <figcaption><span>{project.title}</span><span class="project-index">0{i + 1}</span></figcaption>
                    </figure>
                ))}
            </div>
        </section>
        <section id="contractors" class="trades-section"><div class="wrap section"><div class="trade-photo"><Image src={ContractorPhoto} alt="" width={1400} format="webp" loading="lazy" /></div><p class="eyebrow">03 / {contractors.badge}</p><h2 set:html={contractors.title} /><div class="trades">{contractors.contractors.slice(0, 18).map(item => <span>{item}</span>)}</div><details class="all-trades"><summary>{about.readMore}<span aria-hidden="true">+</span></summary><div class="trades">{contractors.contractors.slice(18).map(item => <span>{item}</span>)}</div></details></div></section>
        <section id="about" class="section wrap about-section">
            <div class="founder"><div class="portrait"><Image src={Jafar} alt={publicSite.owner} width={650} loading="lazy" /></div><div class="founder-caption"><div><strong>{about.author.name}</strong><span>{about.author.role}</span></div><Logo width="30" height="36" /></div></div>
            <div class="about-copy"><p class="eyebrow">04 / {about.badge}</p><h2 set:html={about.title} /><div class="about-intro" set:html={about.description.slice(0, about.description.indexOf('\n\n'))} /><details><summary>{about.readMore}<span aria-hidden="true">+</span></summary><div class="about-full" set:html={about.description.slice(about.description.indexOf('\n\n'))} /></details></div>
        </section>
        <section id="reason" class="why-section">
            <div class="wrap section"><div class="section-heading"><p class="eyebrow">05 / {reason.badge}</p><h2 set:html={reason.title} /></div>
                <div class="reason-grid">{reason.content.map((item, i) => <article><span class="reason-number">0{i + 1}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
            </div>
        </section>
        <section id="process" class="section wrap process-section">
            <div><p class="eyebrow">06 / {process.badge}</p><h2>{process.title}</h2><a class="button" href={bookingLink}>{hero.cta}<span aria-hidden="true">↗</span></a></div>
            <div class="steps">{process.steps.map((step, i) => <article><span class="step-number">0{i + 1}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></article>)}</div>
        </section>
        <section id="faq" class="section wrap faq-section"><div><p class="eyebrow">07 / {faq.badge}</p><h2>{faq.title}</h2></div><div class="faq-list">{faq.content.map((item, i) => <details name="faq"><summary><span class="faq-number">0{i + 1}</span>{item.question}<span class="plus" aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>
        <section id="cta" class="cta wrap"><div class="cta-decoration" aria-hidden="true">↗</div><p class="eyebrow">{publicSite.name}</p><h2>{cta.title}</h2><p>{cta.description}</p><a class="button" href={bookingLink}>{hero.cta}<span aria-hidden="true">↗</span></a></section>
    </main>
    <footer class="wrap footer"><div class="footer-top"><div><a class="brand" href="/indextwo"><Logo width="30" height="36" /><span>{publicSite.name.split(" ")[0]}<span class="brand-small">{publicSite.name.split(" ").slice(1).join(" ")}</span></span></a><p>{footer.intro.title}</p></div><div><p class="eyebrow">{footer.contact.title}</p><a href={`mailto:${publicSite.contact.email}`}>{publicSite.contact.email}</a><a href={`tel:${publicSite.contact.phone}`}>{publicSite.contact.phone}</a><span>{publicSite.location}</span></div><div><p class="eyebrow">{footer.company.title}</p>{nav.map(item => <a href={item.href.replace('/#', '#')}>{item.label}</a>)}</div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} {publicSite.name}</span><div>{footer.resources.items.map(item => <a href={item.href}>{item.label}</a>)}</div></div></footer>
</body>
</html>
<style is:inline>
    .projects-section { border-top: 1px solid var(--line); }
    .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 38px 26px; }
    .project-card { margin: 0; min-width: 0; }
    .project-image { padding: 25px 25px 0; background: #e7edde; border: 1px solid var(--line); border-radius: 13px; overflow: hidden; }
    .project-card:nth-child(3n + 2) .project-image { background: #e9e7dc; }
    .project-card:nth-child(3n) .project-image { background: #dce7e0; }
    .project-image img { width: 100%; height: auto; border-radius: 0 0 5px 5px; }
    .project-browser { display: flex; gap: 5px; padding: 12px; background: white; border-radius: 7px 7px 0 0; }
    .project-browser i { width: 5px; height: 5px; background: #bcc8b6; border-radius: 50%; }
    .project-card figcaption { display: flex; justify-content: space-between; align-items: center; padding: 19px 2px 0; font-size: 18px; font-weight: 600; }
    .project-index { color: var(--muted); font-size: 11px; font-weight: 400; }
    @media (max-width: 520px) {
        .project-grid { grid-template-columns: 1fr; gap: 28px; }
        .project-image { padding: 16px 16px 0; }
        .project-card figcaption { font-size: 16px; padding-top: 14px; }
    }

    .trade-photo{height:400px;border-radius:14px;overflow:hidden;margin-bottom:55px}.trade-photo img{width:100%;height:100%;object-fit:cover;object-position:center 53%}@media(max-width:520px){.trade-photo{height:260px;margin-bottom:35px}.trade-photo img{object-position:65% center}}
    @font-face{font-family:Uplift;src:url('/fonts/body-regular.woff2') format('woff2');font-weight:400;font-display:swap}
    @font-face{font-family:Uplift;src:url('/fonts/body-600.woff2') format('woff2');font-weight:600;font-display:swap}
    @font-face{font-family:Uplift;src:url('/fonts/body-700.woff2') format('woff2');font-weight:700;font-display:swap}
    :root{--paper:#f7f8f2;--ink:#183c30;--muted:#64716a;--lime:#d4ef80;--line:#dce2d7;--white:#fff;scroll-behavior:smooth;scroll-padding-top:32px}
    *{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Uplift,Arial,sans-serif;font-size:16px;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}button,a,summary{-webkit-tap-highlight-color:transparent}a:focus-visible,summary:focus-visible{outline:3px solid #779b25;outline-offset:6px}img{display:block;max-width:100%;height:auto}h1,h2,h3,p{margin:0}h1,h2,h3{font-weight:600}h1{font-size:clamp(42px,4.5vw,68px);line-height:1.07;letter-spacing:-3px}h2{font-size:clamp(34px,3.6vw,51px);line-height:1.12;letter-spacing:-2px}h3{font-size:25px;line-height:1.2;letter-spacing:-.65px}p{line-height:1.7}p strong{font-weight:600}h1 .marked-text{color:#729343}h2 .marked-text{color:#728c44}.wrap{width:min(1240px,calc(100% - 96px));margin-inline:auto}.header{height:112px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:24px}.brand{display:flex;align-items:center;gap:11px;font-weight:700;font-size:25px;letter-spacing:-1px;line-height:1}.brand-small{display:block;font-size:11px;letter-spacing:2px;text-transform:uppercase;margin-top:6px}.header nav{display:flex;gap:31px;font-size:14px}.header nav a:hover,.text-link:hover{color:#698236}.button{display:inline-flex;gap:36px;align-items:center;justify-content:space-between;padding:19px 25px;background:var(--ink);color:var(--white);border-radius:7px;font-size:15px;font-weight:600;transition:transform .2s,background .2s}.button:hover{background:#2c5641;transform:translateY(-3px)}.button span{font-size:23px;line-height:1}.button.small{padding:14px 19px;font-size:13px;gap:26px}.eyebrow{display:flex;align-items:center;gap:10px;font-size:11px;letter-spacing:1.8px;text-transform:uppercase;font-weight:600;margin-bottom:24px}.status-dot{width:7px;height:7px;background:#81a448;border-radius:50%;flex-shrink:0}.hero{display:grid;grid-template-columns:1.1fr 1fr;gap:55px;align-items:center;padding-top:74px;padding-bottom:72px}.hero-description{font-size:15px;line-height:1.8;color:var(--muted);max-width:500px;margin-top:26px}.hero-description strong{color:#43564b;font-weight:600}.hero-actions{display:flex;align-items:center;gap:30px;margin-top:31px}.text-link{font-size:14px;display:flex;gap:22px;align-items:center}.system{height:530px;position:relative;background:#e9eedf;border:1px solid #dbe2ce;border-radius:20px;overflow:hidden;background-image:radial-gradient(#b6c5ab 1px,transparent 1px);background-size:20px 20px}.system-top{position:absolute;top:25px;left:25px;right:25px;display:flex;justify-content:space-between;font-size:11px;letter-spacing:1px;text-transform:uppercase}.system-top>span:last-child{font-size:24px}.orbit{position:absolute;top:50%;left:50%;border:1px solid #c7d5b9;border-radius:50%;transform:translate(-50%,-50%);width:340px;height:340px}.orbit-two{width:470px;height:470px}.system-core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:146px;height:146px;border-radius:28px;background:var(--ink);color:var(--lime);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:13px;box-shadow:0 16px 40px #233c3020;z-index:1}.system-core>span{font-size:10px}.system-node{position:absolute;width:145px;min-height:94px;background:#ffffffee;border:1px solid #d9e2d0;border-radius:11px;padding:13px;display:flex;align-items:flex-start;gap:9px;box-shadow:0 8px 25px #283d3008;z-index:2;transition:transform .2s}.system-node:hover{transform:translateY(-5px)}.system-node>span:last-child{font-size:11px;line-height:1.45;font-weight:600}.node-icon{font-size:24px;color:#668145;line-height:1}.node-0{top:99px;left:25px}.node-1{top:87px;right:24px}.node-2{top:234px;left:10px;width:125px}.node-3{top:237px;right:10px;width:125px}.node-4{bottom:76px;left:28px}.node-5{bottom:76px;right:22px}.system-bottom{position:absolute;bottom:24px;left:20px;right:20px;display:flex;gap:8px;justify-content:center;align-items:center;font-size:10px}.principles{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:27px 0;gap:20px}.principles>div{display:flex;align-items:center;gap:22px;font-size:16px;font-weight:600}.principles>div>span{color:#85917b;font-size:11px;font-weight:400}.section{padding-top:108px;padding-bottom:108px}.section-heading{display:grid;grid-template-columns:1fr 1.65fr;gap:60px;margin-bottom:48px}.section-heading .eyebrow{padding-top:10px}.section-heading h2{max-width:720px}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:19px}.service-card{scroll-margin-top:30px;background:#fff;border:1px solid var(--line);border-radius:13px;overflow:hidden}.service-copy{padding:30px}.card-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}.service-icon{width:42px;height:42px;display:grid;place-items:center;border-radius:10px;background:#edf2e6;font-size:28px}.index{font-size:12px;color:#8d978b}.service-card h3{margin-bottom:17px}.service-card p{font-size:14px;color:var(--muted)}details{border-top:1px solid var(--line);margin-top:23px}summary{cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:18px;font-size:13px;font-weight:600;padding:19px 0}summary::-webkit-details-marker{display:none}summary>span:last-child{font-size:20px}details[open]>summary>span:last-child{transform:rotate(45deg)}details ul{padding-left:17px;margin:0 0 12px}details li{font-size:14px;line-height:1.7;margin-bottom:14px;color:var(--muted)}.featured{grid-column:span 2;display:grid;grid-template-columns:1fr 1fr;background:#eaf0e2}.featured .service-copy{padding-right:22px}.website-preview{align-self:center;margin:35px -40px 35px 15px;transform:rotate(-4deg);border:6px solid #fff;border-radius:10px;box-shadow:0 16px 35px #244b3220;height:335px;overflow:hidden;background:#fff}.website-preview img{width:100%;height:auto}.browser-bar{display:flex;gap:4px;align-items:center;padding:8px 3px;background:#fff}.browser-bar i{width:4px;height:4px;background:#cad3c4;border-radius:50%}.browser-bar span{font-size:6px;margin-left:12px;color:#83917a}.service-card:last-child{grid-column:span 2}.service-card:last-child .service-copy{display:grid;grid-template-columns:1fr 1fr;column-gap:30px}.service-card:last-child .card-top{grid-column:1/-1}.service-card:last-child details{grid-column:1/-1}.why-section{background:var(--ink);color:#f7f8f2}.why-section .eyebrow{color:#c8d6c0}.why-section h2 .marked-text{color:var(--lime)}.reason-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;margin-top:64px}.reason-grid article{border-top:1px solid #4a6756;padding-top:24px}.reason-number{color:var(--lime);font-size:13px;display:block;margin-bottom:35px}.reason-grid h3{font-size:24px;margin-bottom:16px}.reason-grid p{font-size:14px;color:#c0cec2}.process-section{display:grid;grid-template-columns:1fr 1.3fr;gap:110px}.process-section h2{margin-bottom:30px}.steps article{display:flex;gap:24px;padding-bottom:30px;margin-bottom:30px;border-bottom:1px solid var(--line)}.steps article:last-child{margin-bottom:0}.step-number{flex-shrink:0;width:47px;height:47px;display:grid;place-items:center;background:#e8eddf;border-radius:50%;font-size:13px}.steps h3{font-size:23px;margin:9px 0 16px}.steps p{color:var(--muted);font-size:14px}.trades-section{background:#eef1e7;text-align:center}.trades-section .eyebrow{justify-content:center}.trades-section h2{max-width:640px;margin:0 auto 40px}.trades{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}.trades>span{padding:11px 17px;border:1px solid #d6decb;border-radius:6px;font-size:12px;background:#f7f8f2}.all-trades{max-width:1000px;margin:24px auto 0;border:0}.all-trades summary{justify-content:center}.about-section{display:grid;grid-template-columns:.85fr 1fr;gap:100px;align-items:center}.founder{border-radius:13px;background:#e8eddf;overflow:hidden}.portrait{height:380px;overflow:hidden}.portrait img{width:100%;height:100%;object-fit:cover;object-position:center 30%}.founder-caption{display:flex;justify-content:space-between;align-items:center;padding:24px 27px}.founder-caption strong{font-size:19px}.founder-caption span{display:block;font-size:12px;margin-top:6px;color:var(--muted)}.about-copy h2{margin-bottom:27px}.about-intro,.about-full{font-size:16px;line-height:1.8;color:var(--muted)}.about-full>div{margin-bottom:20px}.about-full .icon{display:none}.faq-section{border-top:1px solid var(--line);display:grid;grid-template-columns:.8fr 1.2fr;gap:90px}.faq-list details{margin:0}.faq-list details:last-child{border-bottom:1px solid var(--line)}.faq-list summary{font-size:16px;line-height:1.5;justify-content:flex-start;padding:25px 0}.faq-number{font-size:10px;color:#7c8978;align-self:flex-start;margin-top:5px}.plus{margin-left:auto;flex-shrink:0}.faq-list p{color:var(--muted);font-size:14px;padding:0 30px 25px}.cta{position:relative;overflow:hidden;background:var(--lime);border-radius:16px;padding:65px 70px}.cta h2{max-width:770px;font-size:clamp(36px,4.2vw,59px)}.cta p:not(.eyebrow){max-width:570px;font-size:14px;margin:23px 0 27px;color:#48603a}.cta-decoration{position:absolute;right:18px;top:25px;font-size:300px;line-height:1;color:#bfdc6d;pointer-events:none}.cta>h2,.cta>p,.cta>a{position:relative}.footer{padding-top:75px;padding-bottom:25px}.footer-top{display:grid;grid-template-columns:1.8fr 1.2fr .7fr;gap:50px;padding-bottom:60px}.footer-top>div>p:not(.eyebrow){font-size:13px;color:var(--muted);max-width:240px;margin-top:20px}.footer-top>div>a:not(.brand),.footer-top>div>span{display:block;font-size:13px;color:var(--muted);margin-bottom:12px}.footer-top .eyebrow{margin-bottom:22px}.footer-bottom{display:flex;justify-content:space-between;gap:25px;border-top:1px solid var(--line);padding-top:25px;font-size:11px;color:var(--muted)}.footer-bottom>div{display:flex;gap:25px}.skip{position:absolute;top:-100px;left:20px;background:var(--ink);color:white;padding:15px;z-index:10}.skip:focus{top:15px}
    @media(min-width:1500px){.hero{padding-top:95px;padding-bottom:95px}}
