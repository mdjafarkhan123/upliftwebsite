---
import { Image } from "astro:assets";
import Layout from "../layout/Layout.astro";
import Icon from "../components/Svg.astro";
import Button from "../components/Button.astro";
import Badge from "../components/Badge.astro";
import homeStyle from "../styles/pages/home/home.scss?url";
import { publicSite, hero, brandLogo } from "../data/data.js";
const bookingLink = publicSite.booking.url || publicSite.booking.fallbackUrl;
---

<Layout>
    <section id="hero" class="hero" aria-labelledby="hero-heading">
        <div class="hero__panel panel">
            <Badge title={hero.badge} />
            <h1 id="hero-heading">
                <span class="hero__line">{hero.title.start}</span>{" "}
                <span class="hero__pill" aria-hidden="true">
                    <span class="hero__pill-globe">
                        <Icon name="lu-globe" src="abovethefold" />
                    </span>
                    <Icon name="lu-plus" src="abovethefold" className="hero__pill-plus" />
                    <Icon name="lu-trending-up" src="abovethefold" className="hero__pill-growth" />
                </span>{" "}
                <span class="hero__line">{hero.title.middle}</span>{" "}
                {hero.title.highlights.map((words) => (
                    <>
                        <span class="marked-text">{words}</span>{" "}
                    </>
                ))}
            </h1>
            <p class="hero__description" set:html={hero.description} />
            <div class="hero__actions">
                <Button title={hero.cta} link={bookingLink} data-hero-book="" />
                <Button
                    title={hero.secondaryCta.label}
                    link={hero.secondaryCta.href}
                    type="secondary"
                />
            </div>
            <ul class="assurances">
                {hero.assurances.map((item) => (
                    <li>
                        <Icon name="lu-circle-check" src="abovethefold" aria-hidden="true" />
                        {item}
                    </li>
                ))}
            </ul>
            <div class="hero__visual">
                <div class="hero__photo">
                    <Image
                        class="hero__photo-img"
                        src={hero.photo.image}
                        alt={hero.photo.alt}
                        widths={[480, 920, 1400]}
                        sizes="(min-width: 1200px) 920px, 100vw"
                        loading="eager"
                        fetchpriority="high"
                        format="webp"
                    />
                    <div class="hero__feed-wrap">
                        <p class="sample-label">
                            <Icon name="lu-flask-conical" src="abovethefold" aria-hidden="true" />
                            {hero.sampleLabel}
                        </p>
                        <ul class="hero__feed" aria-label={hero.feedLabel}>
                            {hero.feed.map((item) => (
                                <li class="notification">
                                    <span class="notification__tile" aria-hidden="true">
                                        <Icon name={item.icon} src="abovethefold" />
                                    </span>
                                    <span class="notification__text">
                                        <span class="notification__title">{item.title}</span>
                                        <span>{item.detail}</span>
                                    </span>
                                    <span class="notification__time">{item.time}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
                <div class="status-card">
                    <div>
                        <h2 class="status-card__title">{hero.status.title}</h2>
                        <ul class="status-card__rows">
                            {hero.status.rows.map((row) => (
                                <li class="status-card__row">
                                    {row.label}
                                    <span class="status-pill">{row.status}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                    <div>
                        <p class="status-card__number">
                            <span class="status-card__value">{hero.status.value}</span>
                            {hero.status.unit}
                        </p>
                        <ol class="status-card__days" aria-hidden="true">
                            {Array.from({ length: 10 }, (_, i) => (
                                <li class:list={{ "is-done": i < hero.status.doneDays }} />
                            ))}
                        </ol>
                        <p class="status-card__caption">{hero.status.caption}</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="technology" class="technology" aria-labelledby="technology-heading">
        <div class="technology__wrapper container">
            <h2 id="technology-heading" class="technology__label">
                {brandLogo.title}
            </h2>
            <ul class="technology__logos">
                {brandLogo.logos.map((logo) => (
                    <li>
                        <Image src={logo.image} alt={logo.name} height={28} loading="lazy" />
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- SECTIONS: problem, services, projects, process, pricing, about, reason, contractors, faq, cta -->

    <Fragment slot="bottom-style">
        <link
            rel="stylesheet"
            href={homeStyle}
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link rel="stylesheet" href={homeStyle} />
        </noscript>
    </Fragment>
</Layout>
