---
import { Image } from "astro:assets";
import Layout from "../layout/Layout.astro";
import Logo from "../components/Logo.astro";
import Icon from "../components/Svg.astro";
import Button from "../components/Button.astro";
import Badge from "../components/Badge.astro";
import Accordion from "../components/Accordion.astro";
import ReadMore from "../components/ReadMore.astro";
import Jafar from "../assets/images/jafar.jpg";
import ContractorPhoto from "../assets/images/indextwo-contractor.png";
import homeStyle from "../styles/pages/home/home.scss?url";
import {
    publicSite,
    footer,
    hero,
    brandLogo,
    services,
    projects,
    contractors,
    about,
    reason,
    process,
    faq,
} from "../data/data.js";
import { cta } from "../data/data.js";
const bookingLink = publicSite.booking.url || publicSite.booking.fallbackUrl;
// Use only artwork already in the two public SVG sprites.
const heroIcons = [
    "xp-icon",
    "star-icon",
    "phone-fill",
    "shining-fill",
    "arrow-button",
    "xp-icon",
];
const serviceIcons = [
    { name: "briefcase-icon", src: "sprite" },
    { name: "star-icon", src: "abovethefold" },
    { name: "phone-ringing", src: "sprite" },
    { name: "email-sending", src: "sprite" },
    { name: "location-icon", src: "sprite" },
    { name: "folder-open", src: "sprite" },
];
---

<Layout>
    <section id="hero" class="hero container" aria-labelledby="hero-heading">
        <div class="hero__content">
            <Badge title={hero.badge} dot />
            <h1 id="hero-heading" set:html={hero.title} />
            <div class="hero__description" set:html={hero.description} />
            <div class="hero__actions">
                <Button title={hero.cta} link={bookingLink} />
                <a class="hero__link" href="#services">
                    {services.badge}
                    <Icon
                        name="arrow-button"
                        src="abovethefold"
                        className="hero__link-icon"
                    />
                </a>
            </div>
        </div>
        <div class="hero-system" aria-label={footer.intro.title}>
            <div class="hero-system__header">
                <span>{publicSite.name}</span>
                <button
                    class="hero-system__motion"
                    type="button"
                    aria-label="Pause diagram animation"
                    aria-pressed="false"
                    hidden
                >
                    <span class="hero-system__motion-symbol" aria-hidden="true"
                        >Ⅱ</span
                    >
                </button>
            </div>
            <svg class="hero-system__connections" aria-hidden="true">
                {
                    services.content.map((_, i) => (
                        <g>
                            <line
                                class="hero-system__connection"
                                data-node={i}
                            />
                            <defs>
                                <linearGradient
                                    id={`hero-pulse-${i}`}
                                    gradientUnits="userSpaceOnUse"
                                >
                                    <stop
                                        offset="0"
                                        stop-color="var(--color-primary)"
                                        stop-opacity="0"
                                    />
                                    <stop
                                        offset="0.6"
                                        stop-color="var(--color-primary)"
                                        stop-opacity="0.50"
                                    />
                                    <stop
                                        offset="1"
                                        stop-color="var(--color-primary)"
                                    />
                                </linearGradient>
                            </defs>
                            <line
                                class="hero-system__signal"
                                stroke={`url(#hero-pulse-${i})`}
                            />
                            <g class="hero-system__sparks" />
                        </g>
                    ))
                }
            </svg>
            <div class="hero-system__core">
                <Logo width="52" height="62" />
                <span>Growth System</span>
            </div>
            {
                services.content.map((service, i) => (
                    <a
                        class={`hero-system__node hero-system__node--${i}`}
                        href={`#service-${i}`}
                        style={`--node-index: ${i}`}
                    >
                        <span class="hero-system__icon" aria-hidden="true">
                            <Icon name={heroIcons[i]} src="abovethefold" />
                        </span>
                        <span>{service.title}</span>
                    </a>
                ))
            }
            <div class="hero-system__footer">
                <span class="status-dot"></span>
                {footer.intro.title}
            </div>
        </div>
    </section>
    <section
        id="why"
        class="system-strip container"
        aria-label={brandLogo.title}
    >
        <p class="system-strip__label">{brandLogo.title}</p>
        <div class="system-strip__marks" aria-hidden="true">
            {
                brandLogo.logos.map((mark) => (
                    <span class="system-strip__mark">
                        <Icon name={mark} src={mark} size={28} />
                    </span>
                ))
            }
        </div>
    </section>

    <section
        id="services"
        class="services section container"
        aria-labelledby="services-heading"
    >
        <div class="section__heading">
            <Badge number="01" title={services.badge} />
            <h2 id="services-heading" set:html={services.title} />
        </div>
        <div class="services__grid">
            {
                services.content.map((service, i) => (
                    <article
                        id={`service-${i}`}
                        class:list={[
                            "services__item",
                            { "services__item--featured": i === 0 },
                        ]}
                    >
                        <div class="services__content">
                            <div class="services__meta">
                                <span class="services__icon" aria-hidden="true">
                                    <Icon
                                        name={serviceIcons[i].name}
                                        src={serviceIcons[i].src}
                                    />
                                </span>
                                <span class="services__index">0{i + 1}</span>
                            </div>
                            <h3>{service.title}</h3>
                            <p set:html={service.description} />
                            <ReadMore
                                contentId={`service-more-${i}`}
                                moreLabel={about.readMore}
                                contentClassName="services__more"
                                collapsedLines={3}
                            >
                                <ul>
                                    {service.items.map((item) => (
                                        <li set:html={item} />
                                    ))}
                                </ul>
                            </ReadMore>
                        </div>
                        {i === 0 && (
                            <div class="services__preview">
                                <div class="services__browser">
                                    <i />
                                    <i />
                                    <i />
                                    <span>{publicSite.name}</span>
                                </div>
                                <Image
                                    src={service.thumbnail}
                                    alt="Contractor website design preview"
                                    width={760}
                                    widths={[380, 760]}
                                    sizes="(max-width: 520px) 85vw, 380px"
                                    loading="lazy"
                                />
                            </div>
                        )}
                    </article>
                ))
            }
        </div>
    </section>
    <section
        id="projects"
        class="section container projects"
        aria-labelledby="projects-heading"
    >
        <div class="section__heading">
            <Badge number="02" title={projects.badge} />
            <h2 id="projects-heading">{projects.title}</h2>
        </div>
        <div class="projects__grid">
            {
                projects.items.map((project, i) => (
                    <figure class="projects__item">
                        <div class="projects__image">
                            <div class="projects__browser" aria-hidden="true">
                                <i />
                                <i />
                                <i />
                            </div>
                            <Image
                                src={project.thumbnail}
                                alt={project.title}
                                width={900}
                                widths={[450, 900]}
                                sizes="(max-width: 520px) 90vw, 45vw"
                                loading="lazy"
                            />
                        </div>
                        <figcaption>
                            <span>{project.title}</span>
                            <span class="projects__index">0{i + 1}</span>
                        </figcaption>
                    </figure>
                ))
            }
        </div>
    </section>
    <section
        id="contractors"
        class="contractors"
        aria-labelledby="contractors-heading"
    >
        <div class="container section">
            <div class="contractors__photo">
                <Image
                    src={ContractorPhoto}
                    alt=""
                    width={1400}
                    widths={[480, 800, 1400]}
                    sizes="(max-width: 800px) 95vw, 1240px"
                    format="webp"
                    loading="lazy"
                />
            </div>
            <Badge number="03" title={contractors.badge} />
            <h2 id="contractors-heading" set:html={contractors.title} />
            <div class="contractors__list">
                {
                    contractors.contractors
                        .slice(0, 18)
                        .map((item) => <span>{item}</span>)
                }
            </div>
            <ReadMore
                contentId="contractors-more"
                moreLabel="View more"
                className="contractors__more"
                contentClassName="contractors__list"
            >
                {
                    contractors.contractors
                        .slice(18)
                        .map((item) => <span>{item}</span>)
                }
            </ReadMore>
        </div>
    </section>
    <section
        id="about"
        class="section container about"
        aria-labelledby="about-heading"
    >
        <div class="about__founder">
            <div class="about__portrait">
                <Image
                    src={Jafar}
                    alt={publicSite.owner}
                    width={650}
                    widths={[350, 650]}
                    sizes="(max-width: 520px) 90vw, 470px"
                    loading="lazy"
                />
            </div>
            <div class="about__caption">
                <div>
                    <strong>{about.author.name}</strong>
                    <span>{about.author.role}</span>
                </div>
                <Logo width="30" height="36" />
            </div>
        </div>
        <div class="about__content">
            <Badge number="04" title={about.badge} />
            <h2 id="about-heading" set:html={about.title} />
            <div
                class="about__intro"
                set:html={about.description.slice(
                    0,
                    about.description.indexOf("\n\n"),
                )}
            />
            <ReadMore
                contentId="about-more"
                moreLabel={about.readMore}
                contentClassName="about__full"
                collapsedLines={5}
                contentHtml={about.description.slice(
                    about.description.indexOf("\n\n"),
                )}
            />
        </div>
    </section>
    <section id="reason" class="reason" aria-labelledby="reason-heading">
        <div class="container section">
            <div class="section__heading">
                <Badge number="05" title={reason.badge} />
                <h2 id="reason-heading" set:html={reason.title} />
            </div>
            <div class="reason__grid">
                {
                    reason.content.map((item, i) => (
                        <article>
                            <span class="reason__number">0{i + 1}</span>
                            <h3>{item.title}</h3>
                            <p>{item.description}</p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>
    <section
        id="process"
        class="section container process"
        aria-labelledby="process-heading"
    >
        <div>
            <Badge number="06" title={process.badge} />
            <h2 id="process-heading">{process.title}</h2>
            <Button title={hero.cta} link={bookingLink} />
        </div>
        <div class="process__steps">
            {
                process.steps.map((step, i) => (
                    <article>
                        <span class="process__number">0{i + 1}</span>
                        <div>
                            <h3>{step.title}</h3>
                            <p>{step.description}</p>
                        </div>
                    </article>
                ))
            }
        </div>
    </section>
    <section
        id="faq"
        class="section container faq"
        aria-labelledby="faq-heading"
    >
        <div>
            <Badge number="07" title={faq.badge} />
            <h2 id="faq-heading">{faq.title}</h2>
        </div>
        <div class="faq__list">
            {
                faq.content.map((item, i) => (
                    <Accordion
                        question={item.question}
                        answer={item.answer}
                        number={i}
                    />
                ))
            }
        </div>
    </section>
    <section id="cta" class="cta container" aria-labelledby="cta-heading">
        <div class="cta__decoration" aria-hidden="true">
            <Icon name="arrow-right-up" size={300} />
        </div>
        <Badge title={publicSite.name} />
        <h2 id="cta-heading">{cta.title}</h2>
        <p>{cta.description}</p>
        <Button title={hero.cta} link={bookingLink} />
    </section>

    <Fragment slot="bottom-style">
        <link
            rel="stylesheet"
            href={homeStyle}
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link rel="stylesheet" href={homeStyle} />
            <style>
                .read-more {
                    display: none;
                }
                .services__more[hidden],
                .about__full[hidden] {
                    display: block;
                }
                .contractors__list[hidden] {
                    display: flex;
                }
            </style>
        </noscript>
    </Fragment>
</Layout>
