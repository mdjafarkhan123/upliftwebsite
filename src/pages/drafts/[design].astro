---
import { Image } from "astro:assets";
import Layout from "../../layout/LawnDraftLayout.astro";
import Icon from "../../components/Svg.astro";
import Accordion from "../../components/Accordion.astro";
import SliderController from "../../components/SliderController.astro";
import garden from "../../assets/images/lawn-draft/garden.png";
import gardener from "../../assets/images/lawn-draft/gardener.png";
import patio from "../../assets/images/lawn-draft/patio.png";
import before from "../../assets/images/lawn-draft/before.png";

// This concept is available to Astro dev only. Production generates no draft URL.
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { design: "lawn-care" } }] : [];
}

const services = [
  {
    title: "Lawn care, made effortless.",
    category: "01 / LAWN MAINTENANCE",
    image: garden,
    alt: "Sunlit lawn bordered by mature trees and flowering plants",
    description:
      "A fresh cut. Clean edges. That just-looked-after feeling, without giving up your weekend.",
    tags: ["Mowing & edging", "Seasonal care"],
    value: "Lawn maintenance",
  },
  {
    title: "Good things take tending.",
    category: "02 / GARDEN CARE",
    image: gardener,
    alt: "Concept image of a gardener tending ornamental grasses",
    description:
      "Thoughtful attention for the beds, borders, and little details that make your garden yours.",
    tags: ["Planting & mulching", "Garden upkeep"],
    value: "Garden care",
  },
  {
    title: "Make room for outside.",
    category: "03 / LANDSCAPE REFRESH",
    image: patio,
    alt: "Garden retreat with teak chairs and a curved lawn",
    description:
      "Turn an overlooked corner into your favorite place. A fresh start, from the ground up.",
    tags: ["Bed redesign", "Yard refreshes"],
    value: "Landscape refresh",
  },
];
const questions = [
  [
    "What kind of care does my yard need?",
    "Start with what you want to change: a regular tidy-up, healthier-looking borders, or a complete refresh. Share those priorities in the form below. A property assessment would help define the right scope before work is agreed.",
  ],
  [
    "Can I request a one-time visit?",
    "The proposed service offering includes both one-time refreshes and recurring maintenance. The final service menu, visit frequency, and availability will be confirmed by the lawn-care business before this concept goes live.",
  ],
  [
    "How is a lawn-care quote worked out?",
    "A useful quote considers the size of the property, its current condition, access, the work requested, and visit frequency. The final quote should set out what is included, the schedule, and the price before you decide.",
  ],
  [
    "Do I need to be home during a visit?",
    "Access arrangements, gates, pets, and any areas to avoid should be discussed before a visit. The lawn-care provider can then confirm whether you need to be at home for the planned work.",
  ],
  [
    "What happens after I fill out this form?",
    "In this local design preview, you can try the form and see the confirmation state. No request is sent, no appointment is booked, and your information is not saved. A live enquiry connection will be added only after approval.",
  ],
];
const articles = [
  {
    title: "A little planning. A better backyard.",
    category: "GARDEN PLANNING",
    image: patio,
    text: "Begin with the way you want to use your yard. A quiet seat, room to play, or a welcoming entrance gives the design a purpose. Note the areas you enjoy, the spots you avoid, and what you want to spend less time maintaining. These observations make a helpful starting point for a conversation with a landscape professional.",
  },
  {
    title: "What to include in your lawn-care brief.",
    category: "LAWN NOTES",
    image: garden,
    text: "Share the work you have in mind, your preferred visit frequency, and any access details. Photos of the whole yard and the areas that need attention can help explain your priorities. Ask for a clear written scope so you can see what is included before agreeing to the work.",
  },
  {
    title: "The small details that make a garden.",
    category: "OUTDOOR LIVING",
    image: gardener,
    text: "An inviting garden is more than a lawn. Think about the view from your kitchen, the route to your door, and the place you sit at the end of the day. A considered border or a comfortable resting spot can give an everyday space a stronger sense of purpose.",
  },
];
---

<Layout>
  <section class="hero wrap" aria-labelledby="hero-heading">
    <div class="hero-intro">
      <div>
        <p class="eyebrow">Lawn care. Garden care. A little more life.</p>
        <h1 id="hero-heading">
          A greener yard.
          <br />A better <em>everyday.</em>
        </h1>
      </div>
      <div class="hero-side">
        <p>
          For barefoot mornings. Slow Sundays. And a home that feels good to
          come back to. Let’s make more of your outdoors.
        </p>
        <a class="button" href="#quote">
          Find your greener side <Icon name="arrow-right-up" size={21} />
        </a>
      </div>
    </div>
    <div class="hero-image">
      <Image
        src={garden}
        alt="A lush lawn and softly planted garden surrounding a warm, contemporary home — concept imagery"
        widths={[640, 960, 1440, 1920]}
        sizes="(max-width: 640px) 95vw, 90vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-caption">
        <span aria-hidden="true">
          <Icon name="shining-fill" src="abovethefold" size={20} />
        </span>
        <div>
          <small>A little closer to nature</small>
          <p>Your favorite place could be outside.</p>
        </div>
      </div>
      <a href="#services" class="hero-stamp">
        <span>Rooted in care</span>
        <Icon name="shining-fill" src="abovethefold" />
        <span>Made for living</span>
      </a>
    </div>
    <div class="hero-bottom">
      <div>
        <span>
          <Icon name="checkbox-line" /> Care that fits your space
        </span>
        <span>
          <Icon name="checkbox-line" /> Every detail considered
        </span>
        <span>
          <Icon name="checkbox-line" /> A simpler kind of upkeep
        </span>
      </div>
      <span>Discover the Greenland approach ↓</span>
    </div>
  </section>

  <section
    class="section wrap"
    id="services"
    aria-labelledby="services-heading"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / A little care goes a long way</p>
        <h2 id="services-heading">
          Everything your outdoors
          <br />
          needs to <em>feel its best.</em>
        </h2>
      </div>
      <p class="section-intro">
        From the weekly essentials to a whole new beginning. Find the right kind
        of care for your corner of the world.
      </p>
    </div>
    <div class="service-grid">
      {services.map((service) => (
        <article class="service-card">
          <a
            class="service-picture"
            href="#quote"
            data-service={service.value}
            aria-label={`Enquire about ${service.value.toLowerCase()}`}
          >
            <Image
              src={service.image}
              alt={service.alt}
              widths={[400, 720]}
              sizes="(max-width: 700px) 90vw, 30vw"
              format="webp"
              loading="lazy"
            />
            <span class="round-arrow">
              <Icon name="arrow-right-up" />
            </span>
            <span class="service-category">{service.category}</span>
          </a>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <div class="tags">
            {service.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="about-section" id="about" aria-labelledby="about-heading">
    <div class="wrap about-grid">
      <div class="about-photo">
        <Image
          src={gardener}
          alt="A gardener carefully planting a garden border — illustrative concept"
          widths={[500, 900]}
          sizes="(max-width: 800px) 90vw, 45vw"
          format="webp"
          loading="lazy"
        />
        <div class="photo-note">
          <Icon name="shining-fill" src="abovethefold" size={35} />
          <span>
            Better outdoors.
            <br />
            <em>By nature.</em>
          </span>
        </div>
      </div>
      <div class="about-copy">
        <p class="eyebrow">02 / The Greenland way</p>
        <h2 id="about-heading">
          It’s your yard.
          <br />
          It should feel
          <br />
          <em>like you.</em>
        </h2>
        <p>
          A place to pause. To play. To put down roots. We believe an outdoor
          space should be every bit as welcoming as the home it surrounds.
        </p>
        <p>
          Our approach starts with listening, makes room for the details, and
          brings a little more intention to everyday care.
        </p>
        <a class="text-link" href="#process">
          See how it comes together <Icon name="arrow-right-up" size={19} />
        </a>
      </div>
    </div>
  </section>

  <section class="section wrap why-section" aria-labelledby="why-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / Thoughtful from the ground up</p>
        <h2 id="why-heading">
          Good care is
          <br />
          in the <em>little things.</em>
        </h2>
      </div>
      <p class="section-intro">
        The difference isn’t just what you see.
        <br />
        It’s how the whole experience feels.
      </p>
    </div>
    <div class="principles">
      {[
        [
          "simplicity-icon",
          "Your space. Your plan.",
          "Start with what matters to you, then shape the work around your yard and the way you live.",
        ],
        [
          "email-open",
          "Clear from the start.",
          "A considered scope, a clear quote, and a shared understanding of what happens next.",
        ],
        [
          "shining-fill",
          "The finishing touches.",
          "Edges, borders, and those easy-to-miss corners. Details are what bring the whole space together.",
        ],
        [
          "no-contract",
          "More room to enjoy.",
          "Thoughtful upkeep that makes your outdoor space something to look forward to.",
        ],
      ].map(([icon, title, description], i) => (
        <article>
          <div class="principle-top">
            <Icon
              name={icon}
              src={i === 2 ? "abovethefold" : "sprite"}
              size={29}
            />
            <small>0{i + 1}</small>
          </div>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>

  <section
    class="transformation-section"
    aria-labelledby="transformation-heading"
  >
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">04 / Picture the potential</p>
          <h2 id="transformation-heading">
            Same space.
            <br />
            <em>A whole new feeling.</em>
          </h2>
        </div>
        <div class="section-intro">
          <p>Sometimes, all it takes is seeing what’s possible.</p>
          <p class="image-disclosure">
            Drag to explore an AI-generated garden concept. Not a real customer
            result.
          </p>
        </div>
      </div>
      <div class="comparison" style="--reveal:50%">
        <Image
          class="comparison-after"
          src={garden}
          alt="Illustrative after: healthy lawn and carefully planted borders"
          widths={[700, 1400]}
          sizes="90vw"
          format="webp"
          loading="lazy"
        />
        <Image
          class="comparison-before"
          src={before}
          alt="Illustrative before: patchy grass and untended garden beds"
          widths={[700, 1400]}
          sizes="90vw"
          format="webp"
          loading="lazy"
        />
        <span class="comparison-label comparison-label--before">
          The starting point
        </span>
        <span class="comparison-label comparison-label--after">
          The possibility
        </span>
        <div class="comparison-divider" aria-hidden="true">
          <span>← →</span>
        </div>
        <input
          class="comparison-range"
          type="range"
          min="0"
          max="100"
          value="50"
          aria-label="Reveal before and after garden concept"
          aria-valuetext="50 percent of the starting point visible"
        />
      </div>
      <div class="comparison-foot">
        <span>A garden reimagined · Concept 01</span>
        <span>
          Slide to see the difference <span aria-hidden="true">↔</span>
        </span>
      </div>
    </div>
  </section>

  <section
    class="section wrap projects-section splide"
    id="projects"
    aria-labelledby="projects-heading"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">05 / A few possibilities</p>
        <h2 id="projects-heading">
          Room to play.
          <br />
          Space to <em>just be.</em>
        </h2>
      </div>
      <div class="project-controls">
        <p class="section-intro">
          A little inspiration for your next chapter outdoors.
        </p>
        <SliderController name="garden-projects" />
      </div>
    </div>
    <div class="project-track splide__track">
      <div class="splide__list">
        {[
          {
            image: patio,
            title: "The slow-Sunday garden",
            type: "OUTDOOR LIVING",
            text: "Soft borders, a quiet seat, and space to unwind.",
          },
          {
            image: garden,
            title: "A fresh welcome home",
            type: "LAWN & LANDSCAPE",
            text: "A considered entrance, from the lawn to the last detail.",
          },
          {
            image: gardener,
            title: "A little more life in the borders",
            type: "GARDEN CARE",
            text: "Texture, movement, and a softer edge to the everyday.",
          },
        ].map((project) => (
          <article class="project-card splide__slide">
            <div class="project-photo">
              <Image
                src={project.image}
                alt={project.title + " — generated design concept"}
                widths={[600, 1000]}
                sizes="(max-width: 700px) 85vw, 52vw"
                format="webp"
                loading="lazy"
              />
              <span>Design concept</span>
            </div>
            <div class="project-caption">
              <div>
                <small>{project.type}</small>
                <h3>{project.title}</h3>
                <p>{project.text}</p>
              </div>
              <a
                href="#quote"
                class="round-arrow"
                aria-label={`Discuss an idea like ${project.title.toLowerCase()}`}
              >
                <Icon name="arrow-right-up" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
    <p class="gallery-status" aria-live="polite">
      Showing concept 1 of 3
    </p>
  </section>

  <section
    class="process-section"
    id="process"
    aria-labelledby="process-heading"
  >
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">06 / From first hello to fresh-cut grass</p>
          <h2 id="process-heading">
            Less on your list.
            <br />
            <em>More to look forward to.</em>
          </h2>
        </div>
        <a class="button button-lime" href="#quote">
          Start with your space <Icon name="arrow-right-up" />
        </a>
      </div>
      <div class="process-grid">
        {[
          [
            "Tell us what you have in mind.",
            "A regular refresh or a bigger change? Share your space, your priorities, and a few helpful details.",
          ],
          [
            "Make a plan that feels right.",
            "Discuss the scope, the timing, and a clear quote. Know what to expect before the work begins.",
          ],
          [
            "Make yourself at home. Outside.",
            "With the plan in place, look forward to an outdoor space that works a little better for you.",
          ],
        ].map(([title, text], i) => (
          <article>
            <span class="step-number">
              0{i + 1}
              <Icon name="arrow-right" />
            </span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section
    class="section wrap stories-section"
    aria-labelledby="stories-heading"
  >
    <div>
      <p class="eyebrow">07 / The part that matters most</p>
      <h2 id="stories-heading">
        A yard to love.
        <br />
        <em>A story to share.</em>
      </h2>
      <p>
        Beautiful spaces are only half the story. The other half belongs to the
        people who enjoy them.
      </p>
    </div>
    <div class="review-preview">
      <span class="quote-mark" aria-hidden="true">
        “
      </span>
      <p class="review-title">
        Good work deserves
        <br />
        <em>real words.</em>
      </p>
      <p class="review-note">
        This space is reserved for verified customer stories.
      </p>
      <div class="review-footer">
        <span class="review-avatar">
          <Icon name="person-icon" />
        </span>
        <div>
          <strong>Your customers, in their own words</strong>
          <small>Reviews will be added before launch.</small>
        </div>
      </div>
    </div>
  </section>

  <section class="team-section wrap" aria-labelledby="team-heading">
    <div class="team-image">
      <Image
        src={gardener}
        alt="Illustrative gardener at work, not an actual team member"
        widths={[700, 1300]}
        sizes="(max-width: 800px) 90vw, 55vw"
        format="webp"
        loading="lazy"
      />
      <span class="image-chip">The people behind the care · Concept image</span>
    </div>
    <div class="team-copy">
      <p class="eyebrow">08 / Hands in the soil. Heart in the work.</p>
      <h2 id="team-heading">
        People who care
        <br />
        about your
        <br />
        <em>patch of green.</em>
      </h2>
      <p>
        Good outdoor spaces begin with people who listen, notice the details,
        and take pride in the finish.
      </p>
      <div class="team-roles">
        <div>
          <Icon name="worker-icon" />
          <span>Lawn & garden care</span>
        </div>
        <div>
          <Icon name="process-icon" />
          <span>Landscape planning</span>
        </div>
        <div>
          <Icon name="email-open" />
          <span>A friendly point of contact</span>
        </div>
      </div>
      <small class="image-disclosure">
        Meet-the-team concept. Actual names and profiles to follow.
      </small>
    </div>
  </section>

  <section
    class="section wrap faq-section faq"
    id="faq"
    aria-labelledby="faq-heading"
  >
    <div>
      <p class="eyebrow">09 / A few good questions</p>
      <h2 id="faq-heading">
        Let’s clear
        <br />
        <em>things up.</em>
      </h2>
      <p>
        Every yard is different.
        <br />A good conversation is a great start.
      </p>
      <a class="text-link" href="#quote">
        Ask about your space <Icon name="arrow-right-up" size={18} />
      </a>
    </div>
    <div class="faq-list" role="list">
      {questions.map(([question, answer], number) => (
        <Accordion question={question} answer={answer} number={number} />
      ))}
    </div>
  </section>

  <section
    class="journal-section"
    id="journal"
    aria-labelledby="journal-heading"
  >
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">10 / From the field notes</p>
          <h2 id="journal-heading">
            A little inspiration.
            <br />
            <em>For a lot more outside.</em>
          </h2>
        </div>
        <span class="section-intro">
          Fresh perspectives for your patch of green.
        </span>
      </div>
      <div class="journal-grid">
        {articles.map((article, i) => (
          <article class="journal-card">
            <Image
              src={article.image}
              alt=""
              widths={[400, 700]}
              sizes="(max-width: 700px) 90vw, 30vw"
              format="webp"
              loading="lazy"
            />
            <small>
              {article.category} <span>· 2 MIN READ</span>
            </small>
            <h3>{article.title}</h3>
            <details>
              <summary>
                Read the note <Icon name="arrow-right-up" size={18} />
              </summary>
              <p>{article.text}</p>
            </details>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section
    class="section wrap locations-section"
    id="locations"
    aria-labelledby="locations-heading"
  >
    <div>
      <p class="eyebrow">11 / Good care, closer to home</p>
      <h2 id="locations-heading">
        Your neighborhood.
        <br />
        <em>Your next chapter.</em>
      </h2>
      <p>
        Start with your ZIP code. A local care plan should begin with knowing
        your area.
      </p>
      <a class="text-link" href="#quote">
        Tell us where you grow <Icon name="arrow-right-up" size={18} />
      </a>
    </div>
    <div class="area-card">
      <Icon name="location-icon" size={45} />
      <h3>
        Great care starts
        <br />
        close to home.
      </h3>
      <p>
        Service areas will be confirmed before launch. Add your ZIP code to try
        the enquiry flow.
      </p>
      <div class="area-tags">
        <span>Residential lawns</span>
        <span>Gardens & outdoor spaces</span>
      </div>
    </div>
  </section>

  <section class="quote-section" id="quote" aria-labelledby="quote-heading">
    <div class="wrap quote-grid">
      <div class="quote-copy">
        <p class="eyebrow">Let’s make room for better</p>
        <h2 id="quote-heading">
          Your greener
          <br />
          side <em>starts here.</em>
        </h2>
        <p>
          A few details. A fresh perspective.
          <br />
          Tell us what you’d love your outdoors to be.
        </p>
        <div class="quote-reassurance">
          <span>
            <Icon name="checkbox-line" /> Start with your priorities
          </span>
          <span>
            <Icon name="checkbox-line" /> Explore a plan that fits
          </span>
          <span>
            <Icon name="checkbox-line" /> Know the scope before deciding
          </span>
        </div>
        <span class="quote-flower" aria-hidden="true">
          <Icon name="shining-fill" src="abovethefold" size={135} />
        </span>
      </div>
      <form id="garden-quote" class="quote-form">
        <h3>A little about your space.</h3>
        <p class="form-intro">What can we help you with?</p>
        <div class="field">
          <label for="service">I’m interested in</label>
          <select id="service" name="service" required>
            <option value="">Choose a service</option>
            <option>Lawn maintenance</option>
            <option>Garden care</option>
            <option>Landscape refresh</option>
            <option>I’d like some guidance</option>
          </select>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="name">Your name</label>
            <input
              id="name"
              name="name"
              autocomplete="name"
              placeholder="First and last name"
              required
              maxlength="100"
            />
          </div>
          <div class="field">
            <label for="zip">ZIP code</label>
            <input
              id="zip"
              name="zip"
              autocomplete="postal-code"
              placeholder="Your ZIP code"
              inputmode="numeric"
              pattern="[0-9]{5}(-[0-9]{4})?"
              title="Enter a five-digit ZIP code, optionally followed by a four-digit extension"
              required
            />
          </div>
        </div>
        <div class="field">
          <label for="email">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            required
            maxlength="254"
          />
        </div>
        <div class="field">
          <label for="message">
            What do you have in mind? <span>(optional)</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="3"
            placeholder="A little about your yard and what you’d like to change…"
            maxlength="1500"
          ></textarea>
        </div>
        <button class="button" type="submit" disabled>
          Preview my enquiry <Icon name="arrow-right-up" />
        </button>
        <p class="form-disclosure">
          Design preview only. Nothing is sent or saved.
        </p>
        <noscript>
          <p>Enable JavaScript to try this local form preview.</p>
        </noscript>
        <p
          id="quote-status"
          class="form-status"
          role="status"
          tabindex="-1"
          hidden
        ></p>
      </form>
    </div>
  </section>
</Layout>
