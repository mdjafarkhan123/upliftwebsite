---
import Header from "../components/lawn-draft/Header.astro";
import Footer from "../components/lawn-draft/Footer.astro";
import criticalCss from "../styles/pages/lawn-draft/critical.css?raw";
import pageCss from "../styles/pages/lawn-draft/lawn.scss?url";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="An independent lawn and landscape website design concept. Local preview only."
    />
    <meta name="theme-color" content="#f5f4ec" />
    <title>Greenland — A greener yard. A better everyday. | Design draft</title>
    <link
      rel="preload"
      href="/fonts/body-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/body-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline set:html={criticalCss}></style>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <aside class="draft-label" aria-label="Draft notice">
      <span></span> Design preview{" "}
      <span class="draft-label__detail">
        · Concept imagery · No live enquiries
      </span>
    </aside>
    <link
      rel="stylesheet"
      href={pageCss}
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href={pageCss} />
    </noscript>
    <script src="../code/lawn-draft.js"></script>
  </body>
</html>
