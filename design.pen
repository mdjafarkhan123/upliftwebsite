                  "children": [
                    {
                      "type": "text",
                      "id": "cEPba",
                      "name": "Line 1",
                      "fill": "$color-heading-dark",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Even among good contractors, we keep seeing the same issues come up again and again. It's not because of a lack of effort. They're working hard.",
                      "lineHeight": 1.25,
                      "fontFamily": "$font-heading",
                      "fontSize": 24,
                      "fontWeight": "500",
                      "letterSpacing": -0.6
