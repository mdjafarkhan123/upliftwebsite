                      "fill": "$color-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "It's because the fundamental system isn't in place.",
                      "lineHeight": 1.25,
                      "fontFamily": "$font-heading",
                      "fontSize": 24,
                      "fontWeight": "500",
                      "letterSpacing": -0.6
                    }
                  ]
